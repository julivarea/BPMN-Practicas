    <bpmn:textAnnotation id="TextAnnotation_1t5tbsy">
      <bpmn:text>No nos interesan los detalles del Proveedor. Lo modelamos como una caja negra que envía y recibe mensajes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_06uo5fw" associationDirection="None" sourceRef="Participant_1945psx" targetRef="TextAnnotation_1t5tbsy" />
    <bpmn:textAnnotation id="TextAnnotation_1440t1c">
      <bpmn:text>Notar el borde grueso: es un evento Message Throw que envía el mensaje y termina el proceso</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tszf9i">
      <bpmn:text>XOR Join: A "Verificar información de la solicitud" solo llegamos o desde "Completar solicitud de compra" o desde "Corregir solicitud"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0fv9785" associationDirection="None" sourceRef="Gateway_0boltao" targetRef="TextAnnotation_0tszf9i" />
    <bpmn:textAnnotation id="TextAnnotation_1g93cuj">
      <bpmn:text>Event-based Gateway: Avanza en el camino del evento que ocurra primero: o recibir la cotización, o que pasen los 3 días sin respuesta</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1nggfd2" associationDirection="None" sourceRef="Gateway_0zyv5vi" targetRef="TextAnnotation_1g93cuj" />
  </bpmn:collaboration>
