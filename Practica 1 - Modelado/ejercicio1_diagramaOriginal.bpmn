    <bpmn:participant id="Participant_12hvhrl" name="Aplicante" processRef="Process_12tswsq" />
    <bpmn:participant id="Participant_12j43dy" name="Empresa" processRef="Process_1v0jnuo" />
    <bpmn:messageFlow id="Flow_0n98542" sourceRef="Event_0z7v64n" targetRef="Activity_1vtab7a" />
    <bpmn:messageFlow id="Flow_16ngrcx" sourceRef="Activity_01z596r" targetRef="Event_0qadd2r" />
