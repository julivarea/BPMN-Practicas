  <bpmn:collaboration id="Collaboration_1pikyhk">
    <bpmn:participant id="Participant_0oy3fjs" name="Cliente (caja negra)" processRef="Process_1htuic7" />
    <bpmn:participant id="Participant_0jn0u2q" name="Agencia de Viajes" processRef="Process_1caiy8c" />
    <bpmn:messageFlow id="Flow_0u2l9bs" sourceRef="Event_0fm0mog" targetRef="Participant_0oy3fjs" />
