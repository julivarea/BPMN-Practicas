    <bpmn:messageFlow id="Flow_1z0ipxc" sourceRef="Participant_0oy3fjs" targetRef="Event_1ns9in8" />
    <bpmn:textAnnotation id="TextAnnotation_00se5nc">
      <bpmn:text>Transacción BPMN: Se debe ejecutar en su totalidad para ser exitosa. Cuando falla alguna tarea ejecutamos las compensaciones.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1xacbhh" associationDirection="None" sourceRef="TextAnnotation_00se5nc" targetRef="Activity_1g4e8z6" />
    <bpmn:textAnnotation id="TextAnnotation_0ajcv7f">
      <bpmn:text>Lanzamos un evento de cancelación. Eso hace que se cancele cualquier rama concurrente dentro de la transacción, se activen todas las compensaciones dentro de la transacción, y salgamos por el boundary event de cancelación en vez del flujo normal.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0dtaugo" associationDirection="None" sourceRef="Event_0afhv9z" targetRef="TextAnnotation_0ajcv7f" />
    <bpmn:textAnnotation id="TextAnnotation_1s359kj">
      <bpmn:text>Actividad de compensación. Cuando se activan las compensaciones, se ejecuta esta tarea que deshace a la tarea a la que está conectada.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1x6udf9" associationDirection="None" sourceRef="Activity_00ym04p" targetRef="TextAnnotation_1s359kj" />
    <bpmn:textAnnotation id="TextAnnotation_1ohg8lq">
      <bpmn:text>Activamos las compensaciones</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_09ixrf8" associationDirection="None" sourceRef="TextAnnotation_1ohg8lq" targetRef="Event_10bq5zw" />
  </bpmn:collaboration>
