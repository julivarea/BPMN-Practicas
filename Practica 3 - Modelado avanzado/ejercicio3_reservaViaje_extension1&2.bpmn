    <bpmn:textAnnotation id="TextAnnotation_10odakw">
      <bpmn:text>Subproceso no interruptivo. El cliente puede pedir el cambio de alojamiento. Si no se acepta, termina el subproceso sin interrumpir el proceso general. Si se cambia el alojamiento, ejecutamos la compensación SOLO de alojamiento, reservamos el nuevo alojamiento, y terminamos el subproceso, continuando el resto del proceso general normalmente</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0qzp1j4" associationDirection="None" sourceRef="Activity_02vlmn2" targetRef="TextAnnotation_10odakw" />
  </bpmn:collaboration>
