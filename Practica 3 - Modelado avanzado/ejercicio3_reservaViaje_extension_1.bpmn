    <bpmn:textAnnotation id="TextAnnotation_0nqquxw">
      <bpmn:text>Subproceso no interruptivo. El cliente puede enviar un pedido de nuevo destino. Si no se acepta el cambio, termina el subproceso sin afectar al proceso en el que está contenido (en este caso, las reservas). Si es aceptado el cambio, activamos las compensaciones y emitimos un error para cancelar este subproceso y salir por el boundary event de error hacia la notificación de que no fue posible hacer la reserva original (no usamos el Cancel End Event de las transacciones porque no se puede adentro de subprocesos de eventos)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1bx8wrj" associationDirection="None" sourceRef="Activity_09evhql" targetRef="TextAnnotation_0nqquxw" />
  </bpmn:collaboration>
